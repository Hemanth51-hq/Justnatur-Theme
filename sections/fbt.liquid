{%- liquid
  assign main = product
  assign complement = all_products[section.settings.complement_product]
-%}

<section class="section section--tight">
  <div class="page-width">
    <div class="reveal" style="max-width:40rem;margin-bottom:1.25rem;">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="display" style="font-size:clamp(1.5rem,3.5vw,2.3rem);">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="lede">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="fbt reveal">
      <div class="fbt__items">
        <div class="fbt__item">
          <div class="fbt__media">
            {%- if main.featured_media -%}
              {{ main.featured_media | image_url: width: 240 | image_tag: loading: 'lazy', alt: main.title }}
            {%- endif -%}
          </div>
          <div>
            <div class="fbt__title">{{ main.title }}</div>
            <div class="muted">{{ main.price | money }}</div>
          </div>
        </div>

        <div class="fbt__plus" aria-hidden="true">+</div>

        <div class="fbt__item">
          <div class="fbt__media">
            {%- if complement != blank and complement.featured_media -%}
              {{ complement.featured_media | image_url: width: 240 | image_tag: loading: 'lazy', alt: complement.title }}
            {%- else -%}
              <div class="fbt__media-fallback">{% render 'icon', icon: 'oil' %}</div>
            {%- endif -%}
          </div>
          <div>
            <div class="fbt__title">
              {%- if complement != blank -%}
                {{ complement.title }}
              {%- else -%}
                {{ section.settings.fallback_title }}
              {%- endif -%}
            </div>
            <div class="muted">
              {%- if complement != blank -%}
                {{ complement.price | money }}
              {%- else -%}
                {{ section.settings.fallback_price }}
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>

      <div class="fbt__action">
        <div class="fbt__bundle-label">{{ section.settings.bundle_label }}</div>
        {%- if complement != blank -%}
          <form method="post" action="/cart/add" data-fbt-form>
            <input type="hidden" name="items[0][id]" value="{{ main.selected_or_first_available_variant.id }}">
            <input type="hidden" name="items[0][quantity]" value="1">
            <input type="hidden" name="items[1][id]" value="{{ complement.selected_or_first_available_variant.id }}">
            <input type="hidden" name="items[1][quantity]" value="1">
            <button class="btn btn--primary btn--full btn--magnetic" type="submit" data-ripple>
              {{ section.settings.button_label }}
            </button>
          </form>
        {%- else -%}
          <a class="btn btn--primary btn--full" href="{{ section.settings.fallback_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
        <p class="muted" style="font-size:0.82rem;margin:0.6rem 0 0;">{{ section.settings.note }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Frequently bought together",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Complete the ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently bought together" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Inside nutrition + outside oil care — India’s inside-out hair routine."
    },
    { "type": "product", "id": "complement_product", "label": "Complement product" },
    { "type": "text", "id": "fallback_title", "label": "Fallback title", "default": "Kesha Amrith Hair Oil" },
    { "type": "text", "id": "fallback_price", "label": "Fallback price text", "default": "From ₹599" },
    { "type": "url", "id": "fallback_link", "label": "Fallback link" },
    { "type": "text", "id": "bundle_label", "label": "Bundle label", "default": "Complete Hair Kit" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Add both to cart" },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "Bundle adds both products to cart. Discounts can be applied via Shopify automatic discounts."
    }
  ],
  "presets": [{ "name": "Frequently bought together" }]
}
{% endschema %}
