<section class="section{% if section.settings.soft_bg %} section--soft{% endif %}">
  <div class="page-width">
    <div class="editorial-band{% if section.settings.layout == 'reverse' %} editorial-band--reverse{% endif %}{% if section.settings.layout == 'center' %} editorial-band--center{% endif %}">
      {%- unless section.settings.layout == 'center' -%}
        <div class="media-frame reveal mask-reveal">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1400
              | image_tag: loading: 'lazy', widths: '700,1000,1400', sizes: '(min-width: 900px) 45vw, 100vw', alt: section.settings.heading
            }}
          {%- else -%}
            <div style="width:100%;height:100%;display:grid;place-items:center;padding:2rem;text-align:center;background:linear-gradient(160deg,var(--color-accent-soft),var(--color-secondary));">
              <div>
                <div style="font-size:2rem;font-weight:600;letter-spacing:-0.03em;">JustNatur</div>
                <p class="muted" style="margin:0.5rem 0 0;">Modern Ayurveda. Measured for daily life.</p>
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- endunless -%}

      <div class="reveal stack-md">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="display">{{ section.settings.heading }}</h2>
        <div class="lede rte">{{ section.settings.text }}</div>
        {%- if section.settings.button_label != blank -%}
          <div>
            <a class="btn btn--primary btn--magnetic" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial story",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "left", "label": "Image left" },
        { "value": "reverse", "label": "Image right" },
        { "value": "center", "label": "Centered text" }
      ],
      "default": "left"
    },
    { "type": "checkbox", "id": "soft_bg", "label": "Soft background", "default": false },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Chapter 01" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hair fall doesn’t start on the scalp. It starts inside."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Shampoos care for the shaft. Kesha Mula feeds the root — clean botanicals for a calmer shedding cycle.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the blend" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Editorial story" }
  ]
}
{% endschema %}
