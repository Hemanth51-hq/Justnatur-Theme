<section class="section">
  <div class="page-width">
    <p class="eyebrow">Collections</p>
    <h1 class="display" style="font-size:clamp(2rem,4vw,3rem);margin-bottom:2rem;">Shop by collection</h1>
    <div class="product-grid">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'all' -%}
          <a class="product-card reveal" href="{{ collection.url }}">
            <div class="product-card__media">
              {%- if collection.featured_image -%}
                {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: collection.title }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <h2 class="product-card__title">{{ collection.title }}</h2>
            <div class="muted">{{ collection.products_count }} products</div>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list"
}
{% endschema %}
