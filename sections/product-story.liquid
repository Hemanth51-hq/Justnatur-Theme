<section class="section{% if section.settings.soft_bg %} section--soft{% endif %}">
  <div class="page-width">
    <div class="story-split">
      <div class="reveal">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="display">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="lede rte">{{ section.settings.text }}</div>
        {%- endif -%}

        <div class="stat-grid">
          {%- for block in section.blocks -%}
            <div class="stat" {{ block.shopify_attributes }}>
              <div class="stat__value">{{ block.settings.value }}</div>
              <div class="stat__label">{{ block.settings.label }}</div>
              {%- if block.settings.description != blank -%}
                <div class="stat__desc">{{ block.settings.description }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="media-frame reveal">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag: loading: 'lazy', widths: '600,900,1200', sizes: '(min-width: 860px) 40vw, 100vw', alt: section.settings.image.alt
          }}
        {%- else -%}
          <div style="width:100%;height:100%;display:grid;place-items:center;padding:2rem;text-align:center;">
            <div>
              <div style="font-family:var(--font-display);font-size:2rem;margin-bottom:0.5rem;">14 herbs</div>
              <p class="muted" style="margin:0;">One deep-root nutrition blend. No coatings. No shortcuts.</p>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product story",
  "settings": [
    {
      "type": "checkbox",
      "id": "soft_bg",
      "label": "Soft background",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Ayurveda’s root ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "When roots weaken, everything feels thinner."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Kesha Mula brings whole botanicals together to support the body’s natural hair nutrition — so strength returns where growth begins.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "14"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Herbs"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "One classical blend"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product story",
      "blocks": [
        {
          "type": "stat",
          "settings": { "value": "14", "label": "Botanicals", "description": "Whole-herb formula" }
        },
        {
          "type": "stat",
          "settings": { "value": "1 scoop", "label": "Daily ritual", "description": "No measuring stress" }
        },
        {
          "type": "stat",
          "settings": { "value": "4 wks", "label": "Visible shift", "description": "Less fall, denser feel" }
        },
        {
          "type": "stat",
          "settings": { "value": "100%", "label": "Natural", "description": "No preservatives" }
        }
      ]
    }
  ]
}
{% endschema %}
