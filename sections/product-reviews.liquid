<section class="section section--soft">
  <div class="page-width">
    <div class="reviews-header reveal">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="display" style="font-size:clamp(1.8rem,3.5vw,2.8rem);">{{ section.settings.heading }}</h2>
      </div>
      <div class="muted">{{ section.settings.subheading }}</div>
    </div>

    <div class="review-grid">
      {%- for block in section.blocks -%}
        <article class="review reveal" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index0 | times: 0.08 }}s;">
          <div class="stars" aria-label="{{ block.settings.rating }} stars">
            {%- for i in (1..5) -%}
              {%- if i <= block.settings.rating -%}★{%- else -%}☆{%- endif -%}
            {%- endfor -%}
          </div>
          <h3 class="review__title">{{ block.settings.title }}</h3>
          <p class="review__body">{{ block.settings.body }}</p>
          <div class="review__author">{{ block.settings.author }}</div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product reviews",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Social proof"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let customers speak for us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "From women rebuilding their roots with Kesha Mula"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Less fall in weeks"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "I noticed less hair on my pillow within a few weeks. The ritual is easy and the ingredients feel clean."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Ananya"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "title": "Less fall in weeks",
            "body": "I noticed less hair on my pillow within a few weeks. The ritual is easy and the ingredients feel clean.",
            "author": "Ananya"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Finally something internal",
            "body": "Oils never fixed my shedding. Kesha Mula feels like the first product that addresses the root cause properly.",
            "author": "Meera"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Hair feels denser",
            "body": "After a month my parting looks softer and my hair feels stronger when I wash it. Packaging and taste are both thoughtful.",
            "author": "Ritika"
          }
        }
      ]
    }
  ]
}
{% endschema %}
