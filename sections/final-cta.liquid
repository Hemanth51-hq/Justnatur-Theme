<section class="section">
  <div class="page-width">
    <div class="final-cta reveal">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="display">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="lede">{{ section.settings.text }}</p>
      {%- endif -%}
      <div class="final-cta__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn--primary" href="{{ section.settings.button_link | default: '#MainContent' }}">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="btn btn--ghost" style="border-color:rgba(255,255,255,0.28);color:#fff;" href="{{ section.settings.secondary_link }}">
            {{ section.settings.secondary_label }}
          </a>
        {%- endif -%}
      </div>
      {%- if section.settings.pills != blank -%}
        <div class="proof-strip" style="justify-content:center;margin-top:1.4rem;">
          {%- assign pills = section.settings.pills | split: '|' -%}
          {%- for pill in pills -%}
            <span class="proof-pill">{{ pill | strip }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Start tonight"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start your 30-day nourishment journey today"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Join thousands rebuilding their roots with Kesha Mula — clean nutrition, visible less fall in weeks."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Choose your pack"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary label",
      "default": "Read FAQs"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "text",
      "id": "pills",
      "label": "Proof pills",
      "default": "Trusted by 10,000+ | 90-day guarantee | Free express shipping | Clinically proven"
    }
  ],
  "presets": [
    {
      "name": "Final CTA"
    }
  ]
}
{% endschema %}
