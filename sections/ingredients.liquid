<section class="section">
  <div class="page-width">
    <div class="reveal" style="max-width:42rem;">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="display">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="lede">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="ingredient-grid">
      {%- for block in section.blocks -%}
        <article class="ingredient reveal" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index0 | times: 0.05 }}s;">
          <div class="ingredient__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- else -%}
              {{ block.settings.title | slice: 0 }}
            {%- endif -%}
          </div>
          <div class="ingredient__meta">
            <div class="ingredient__tag">{{ block.settings.tag | default: 'Botanical' }}</div>
            <h3>{{ block.settings.title }}</h3>
            <div class="ingredient__dual">
              {%- if block.settings.science != blank -%}
                <p><strong>Science:</strong> {{ block.settings.science }}</p>
              {%- endif -%}
              {%- if block.settings.ayurveda != blank -%}
                <p><strong>Ayurveda:</strong> {{ block.settings.ayurveda }}</p>
              {%- endif -%}
              {%- if block.settings.science == blank and block.settings.ayurveda == blank -%}
                <p>{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.chips != blank -%}
      <div class="chip-row reveal">
        {%- assign chips = section.settings.chips | split: '|' -%}
        {%- for chip in chips -%}
          <span class="chip">{{ chip | strip }}</span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ingredients",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inside the blend" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Herbs with a reason. Not a filler list."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Each botanical in Kesha Mula was chosen for both modern nutrition and classical Ayurvedic use."
    },
    {
      "type": "text",
      "id": "chips",
      "label": "Trust chips",
      "default": "Food-grade | Pesticide free | No preservatives | 100% vegan"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Hero herb" },
        { "type": "text", "id": "title", "label": "Title", "default": "Amla" },
        { "type": "textarea", "id": "science", "label": "Science", "default": "Naturally rich in vitamin C and polyphenols that support antioxidant defense." },
        { "type": "textarea", "id": "ayurveda", "label": "Ayurveda", "default": "Classically used to support scalp vitality and hair strength from within." },
        { "type": "textarea", "id": "text", "label": "Fallback text", "default": "Supports follicle vitality." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "tag": "Hero herb",
            "title": "Amla",
            "science": "Naturally rich in vitamin C and polyphenols that support antioxidant defense.",
            "ayurveda": "A classic rasayana for scalp vitality and hair strength."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "tag": "Omega support",
            "title": "Flaxseed",
            "science": "Provides plant omegas that help nourish hair from the inside out.",
            "ayurveda": "Used to support internal balance and daily nourishment."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "tag": "Digestive ally",
            "title": "Cumin",
            "science": "Food-grade spice traditionally linked with digestion and nutrient uptake.",
            "ayurveda": "Supports agni — so nutrition can actually be absorbed."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "tag": "Mineral tone",
            "title": "Beetroot",
            "science": "Adds natural sweetness and iron-supportive plant nutrition.",
            "ayurveda": "Balances the blend so the ritual stays easy, not bitter."
          }
        }
      ]
    }
  ]
}
{% endschema %}
