<section class="section">
  <div class="page-width">
    <h1 class="display" style="font-size:clamp(2rem,4vw,3rem);margin-bottom:1.5rem;">Search</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:0.6rem;max-width:36rem;margin-bottom:2rem;">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t }}"
        style="flex:1;padding:0.85rem 1.1rem;border-radius:999px;border:1px solid var(--color-border);background:#fff;"
      >
      <button class="btn btn--primary" type="submit">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p class="muted">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- else -%}
        <p class="muted" style="margin-bottom:1.25rem;">{{ 'general.search.results_with_count' | t: terms: search.terms, count: search.results_count }}</p>
        <div class="product-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search"
}
{% endschema %}
