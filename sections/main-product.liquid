{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured = product.selected_or_first_available_variant.featured_media | default: product.featured_media
  assign rating_text = section.settings.rating_text | default: settings.social_proof_rating
  assign buyers_text = section.settings.buyers_text | default: settings.social_proof_buyers
  assign pack2_price = current_variant.price | times: 2
  assign pack3_price = current_variant.price | times: 3
  if section.settings.pack_2_sale_price > 0
    assign pack2_price = section.settings.pack_2_sale_price | times: 100
  endif
  if section.settings.pack_3_sale_price > 0
    assign pack3_price = section.settings.pack_3_sale_price | times: 100
  endif
-%}

<section class="product-main" data-product-section>
  <div class="page-width product-main__grid">
    <div class="product-gallery" data-product-gallery>
      <div class="product-gallery__main">
        {%- if featured -%}
          <img
            src="{{ featured | image_url: width: 1200 }}"
            srcset="{{ featured | image_url: width: 600 }} 600w, {{ featured | image_url: width: 900 }} 900w, {{ featured | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 980px) 48vw, 100vw"
            alt="{{ featured.alt | default: product.title | escape }}"
            width="1200"
            height="1200"
            fetchpriority="high"
            data-gallery-main
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <div class="product-gallery__thumbs">
          {%- for media in product.media limit: 6 -%}
            <button
              type="button"
              class="product-gallery__thumb{% if media == featured %} is-active{% endif %}"
              data-gallery-thumb
              data-src="{{ media | image_url: width: 1200 }}"
              data-srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w"
              aria-label="View image {{ forloop.index }}"
            >
              {%- assign thumb_alt = media.alt | default: product.title -%}
              {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: thumb_alt }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product-info">
      {%- if section.settings.kicker != blank -%}
        <p class="product-info__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}

      <h1 class="product-info__title">{{ product.title }}</h1>

      {%- if section.settings.show_rating -%}
        <div class="product-info__rating">
          <span class="stars" aria-hidden="true">
            {% render 'icon', icon: 'star', size: 16 %}
            {% render 'icon', icon: 'star', size: 16 %}
            {% render 'icon', icon: 'star', size: 16 %}
            {% render 'icon', icon: 'star', size: 16 %}
            {% render 'icon', icon: 'star', size: 16 %}
          </span>
          <span>{{ rating_text }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.promise_text != blank -%}
        <div class="product-promise">
          {%- assign promises = section.settings.promise_text | split: '|' -%}
          {%- for promise in promises -%}
            <span>{{ promise | strip }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="price" style="margin-top:0.25rem;">
        <span class="price__regular" data-pack-price>{{ current_variant.price | money }}</span>
        <span
          class="price__compare"
          data-pack-compare
          {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}
        >
          {{ current_variant.compare_at_price | money }}
        </span>
        <span class="price__save" data-pack-save {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>
          Save
        </span>
      </div>

      {%- if section.settings.urgency_text != blank -%}
        <div class="urgency-bar">{{ section.settings.urgency_text }}</div>
      {%- endif -%}

      {%- if section.settings.enable_scarcity and section.settings.scarcity_text != blank -%}
        <div class="scarcity-bar" data-scarcity>
          <span class="scarcity-bar__dot" aria-hidden="true"></span>
          <span data-scarcity-text>{{ section.settings.scarcity_text }}</span>
          {%- if section.settings.scarcity_stock != blank -%}
            <strong data-scarcity-stock>{{ section.settings.scarcity_stock }} left</strong>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.enable_recent and section.settings.recent_text != blank -%}
        <div class="recent-purchase" data-recent-purchase>
          {% render 'icon', icon: 'tick', size: 16 %}
          <span>{{ section.settings.recent_text }}</span>
        </div>
      {%- endif -%}

      {%- form 'product', product, data-product-form: true, id: 'ProductForm' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

        <div class="pack-picker" data-pack-picker>
          <div class="pack-picker__label">{{ section.settings.pack_heading }}</div>
          <div class="pack-options">
            <button
              type="button"
              class="pack-option is-selected"
              data-pack-option
              data-qty="1"
              data-price="{{ current_variant.price }}"
              data-compare="{{ current_variant.compare_at_price | default: current_variant.price }}"
              data-total="{{ current_variant.price }}"
            >
              <span class="pack-option__radio" aria-hidden="true"></span>
              <span>
                <div class="pack-option__title">{{ section.settings.pack_1_title }}</div>
                <div class="pack-option__meta">{{ section.settings.pack_1_meta }}</div>
              </span>
              <span class="pack-option__price">{{ current_variant.price | money }}</span>
            </button>

            <button
              type="button"
              class="pack-option"
              data-pack-option
              data-qty="2"
              data-price="{{ current_variant.price }}"
              data-compare="{{ current_variant.compare_at_price | default: current_variant.price | times: 2 }}"
              data-total="{{ pack2_price }}"
            >
              {%- if section.settings.pack_2_badge != blank -%}
                <span class="pack-option__badge badge badge--hot">{{ section.settings.pack_2_badge }}</span>
              {%- endif -%}
              <span class="pack-option__radio" aria-hidden="true"></span>
              <span>
                <div class="pack-option__title">{{ section.settings.pack_2_title }}</div>
                <div class="pack-option__meta">{{ section.settings.pack_2_meta }}</div>
              </span>
              <span class="pack-option__price">{{ pack2_price | money }}</span>
            </button>

            <button
              type="button"
              class="pack-option"
              data-pack-option
              data-qty="3"
              data-price="{{ current_variant.price }}"
              data-compare="{{ current_variant.compare_at_price | default: current_variant.price | times: 3 }}"
              data-total="{{ pack3_price }}"
            >
              {%- if section.settings.pack_3_badge != blank -%}
                <span class="pack-option__badge badge">{{ section.settings.pack_3_badge }}</span>
              {%- endif -%}
              <span class="pack-option__radio" aria-hidden="true"></span>
              <span>
                <div class="pack-option__title">{{ section.settings.pack_3_title }}</div>
                <div class="pack-option__meta">{{ section.settings.pack_3_meta }}</div>
              </span>
              <span class="pack-option__price">{{ pack3_price | money }}</span>
            </button>
          </div>
          <p class="pack-note muted">{{ section.settings.pack_note }}</p>
        </div>

        {%- unless product.has_only_default_variant -%}
          <div class="stack-sm">
            {%- for option in product.options_with_values -%}
              <label class="pack-picker__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label>
              <select
                id="Option-{{ section.id }}-{{ forloop.index0 }}"
                name="options[{{ option.name | escape }}]"
                class="field-select"
              >
                {%- for value in option.values -%}
                  <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                {%- endfor -%}
              </select>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        <div class="quantity-row" data-atc-anchor>
          <div class="qty" data-qty>
            <button type="button" data-delta="-1" aria-label="Decrease quantity">−</button>
            <input type="number" name="quantity" value="1" min="1" data-qty-input aria-label="{{ 'products.product.quantity' | t }}">
            <button type="button" data-delta="1" aria-label="Increase quantity">+</button>
          </div>
          <button
            type="submit"
            class="btn btn--primary btn--full btn--magnetic"
            data-ripple
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {%- if current_variant.available -%}
              {{ section.settings.atc_label | default: 'Add to cart' }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </button>
        </div>
      {%- endform -%}

      {%- if settings.enable_cart_progress -%}
        <div class="offer-progress" data-offer-progress data-cart-total="{{ cart.total_price }}">
          <div class="offer-progress__labels">
            <span>{{ settings.progress_tier_1_label }}</span>
            <span>{{ settings.progress_tier_2_label }}</span>
            <span>{{ settings.progress_tier_3_label }}</span>
          </div>
          <div class="offer-progress__track">
            <div class="offer-progress__fill" data-progress-fill style="width:0%"></div>
          </div>
          <p class="offer-progress__msg muted" data-progress-msg>Add more to unlock rewards</p>
        </div>
      {%- endif -%}

      <div class="checkout-trust">
        <div class="checkout-trust__row">
          <span>{% render 'icon', icon: 'cod', size: 18 %} {{ section.settings.cod_text }}</span>
          <span>{% render 'icon', icon: 'truck', size: 18 %} {{ section.settings.delivery_text }}</span>
        </div>
        <div class="checkout-trust__row">
          <span>{% render 'icon', icon: 'return', size: 18 %} {{ section.settings.returns_text }}</span>
          <span>{% render 'icon', icon: 'shield', size: 18 %} {{ section.settings.secure_text }}</span>
        </div>
        <div class="payment-icons" aria-label="Payment methods">
          <span class="payment-chip">{% render 'icon', icon: 'upi', size: 16 %} UPI</span>
          <span class="payment-chip">{% render 'icon', icon: 'cod', size: 16 %} COD</span>
          <span class="payment-chip">{% render 'icon', icon: 'card', size: 16 %} Cards</span>
          <span class="payment-chip">{% render 'icon', icon: 'shield', size: 16 %} Netbanking</span>
        </div>
      </div>

      <div class="assurance-strip">
        <span><strong>{{ rating_text }}</strong></span>
        <span><strong>{{ buyers_text }}</strong></span>
        <span><strong>Lab tested</strong> · Heavy-metal screened</span>
      </div>
    </div>
  </div>
</section>

{%- if settings.enable_sticky_atc -%}
  <div class="sticky-atc" data-sticky-atc>
    <div class="page-width sticky-atc__inner">
      <div class="sticky-atc__info">
        <div class="sticky-atc__thumb">
          {%- if featured -%}
            {{ featured | image_url: width: 120 | image_tag: loading: 'lazy', alt: product.title }}
          {%- endif -%}
        </div>
        <div style="min-width:0;">
          <div class="sticky-atc__title">{{ product.title }}</div>
          <div class="sticky-atc__price">
            <span data-sticky-price>{{ current_variant.price | money }}</span>
            · COD available
          </div>
        </div>
      </div>
      <button type="button" class="btn btn--primary btn--magnetic" data-sticky-submit data-ripple {% unless current_variant.available %}disabled{% endunless %}>
        {{ section.settings.atc_label | default: 'Add to cart' }}
      </button>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product information",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "FROM WITHIN | NOT TOPICAL | CLINICALLY PROVEN" },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.6/5 · Based on 50 reviews" },
    { "type": "text", "id": "buyers_text", "label": "Buyers text", "default": "Trusted by 10,000+ people" },
    {
      "type": "text",
      "id": "promise_text",
      "label": "Promise chips",
      "default": "Fights hair fall at the root | Visible results in weeks | 100% natural | Clinically proven",
      "info": "Separate with |"
    },
    {
      "type": "text",
      "id": "urgency_text",
      "label": "Urgency bar",
      "default": "Get free Kesha Amrith Hair Oil on prepaid orders · 90-day money-back"
    },
    { "type": "checkbox", "id": "enable_scarcity", "label": "Show scarcity (theme-editable only)", "default": false },
    { "type": "text", "id": "scarcity_text", "label": "Scarcity text", "default": "Selling fast this week" },
    { "type": "text", "id": "scarcity_stock", "label": "Stock remaining label", "default": "37", "info": "Leave blank to hide stock number. Never invent fake stock." },
    { "type": "checkbox", "id": "enable_recent", "label": "Show recently purchased note", "default": true },
    { "type": "text", "id": "recent_text", "label": "Recently purchased text", "default": "Ananya from Hyderabad bought this 12 mins ago" },
    { "type": "text", "id": "pack_heading", "label": "Pack heading", "default": "Choose your hair transformation pack" },
    { "type": "text", "id": "pack_1_title", "label": "Pack 1 title", "default": "Trail Pack · 15 Days" },
    { "type": "text", "id": "pack_1_meta", "label": "Pack 1 meta", "default": "1 pouch · Start the root ritual" },
    { "type": "text", "id": "pack_2_title", "label": "Pack 2 title", "default": "Value Pack · 2 units" },
    { "type": "text", "id": "pack_2_meta", "label": "Pack 2 meta", "default": "Most chosen · Better per-day value" },
    { "type": "text", "id": "pack_2_badge", "label": "Pack 2 badge", "default": "Most chosen" },
    { "type": "number", "id": "pack_2_sale_price", "label": "Pack 2 total price (₹)", "default": 0, "info": "0 = 2 × variant price" },
    { "type": "text", "id": "pack_3_title", "label": "Pack 3 title", "default": "Best Deal · 3 units" },
    { "type": "text", "id": "pack_3_meta", "label": "Pack 3 meta", "default": "Best value for 90-day consistency" },
    { "type": "text", "id": "pack_3_badge", "label": "Pack 3 badge", "default": "Best value" },
    { "type": "number", "id": "pack_3_sale_price", "label": "Pack 3 total price (₹)", "default": 0, "info": "0 = 3 × variant price" },
    {
      "type": "text",
      "id": "pack_note",
      "label": "Pack honesty note",
      "default": "Packs add multiple units of this product. Pair with Kesha Amrith from Frequently Bought Together below."
    },
    { "type": "text", "id": "atc_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "text", "id": "cod_text", "label": "COD text", "default": "COD available" },
    { "type": "text", "id": "delivery_text", "label": "Delivery text", "default": "3–5 day delivery" },
    { "type": "text", "id": "returns_text", "label": "Returns text", "default": "90-day ease" },
    { "type": "text", "id": "secure_text", "label": "Secure text", "default": "Secure checkout" }
  ],
  "presets": [{ "name": "Product information" }]
}
{% endschema %}
