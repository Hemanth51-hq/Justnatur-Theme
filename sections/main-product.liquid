      "default": "4.6/5 · Based on 151 reviews"
    },
    {
      "type": "text",
      "id": "promise_text",
      "label": "Promise chips",
      "default": "5× Less Hair Fall | 3× Stronger Roots | 2× Visible Regrowth | Clinically Proven",
      "info": "Separate with |"
    },
    {
      "type": "text",
      "id": "urgency_text",
      "label": "Urgency bar",
      "default": "Get free Kesha Amrith Hair Oil on prepaid orders · 90-day money-back guarantee"
    },
    {
      "type": "text",
      "id": "pack_heading",
      "label": "Pack heading",
      "default": "Choose your hair transformation pack"
    },
    {
      "type": "text",
      "id": "pack_1_title",
