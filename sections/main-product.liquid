      "default": "Trail Pack · 15 Days"
    },
    {
      "type": "text",
      "id": "pack_1_meta",
      "label": "Pack 1 meta",
      "default": "1 pouch · Start the root ritual"
    },
    {
      "type": "text",
      "id": "pack_2_title",
      "label": "Pack 2 title",
      "default": "Value Pack · Any 2"
    },
    {
      "type": "text",
      "id": "pack_2_meta",
      "label": "Pack 2 meta",
      "default": "Select your combo"
    },
    {
      "type": "text",
      "id": "pack_2_badge",
      "label": "Pack 2 badge",
      "default": "Most chosen"
    },
    {
      "type": "text",
      "id": "pack_3_title",
      "label": "Pack 3 title",
      "default": "Best Deal · Any 3"
    },
    {
      "type": "text",
      "id": "pack_3_meta",
      "label": "Pack 3 meta",
      "default": "Select your combo"
    },
    {
      "type": "text",
      "id": "pack_3_badge",
      "label": "Pack 3 badge",
