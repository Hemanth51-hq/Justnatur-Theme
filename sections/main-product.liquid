      "label": "Sibling product 2 name",
      "default": "Kesha Combo"
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "star", "label": "Star" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Delivery within India"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Same-day dispatch · Free shipping · 3–5 business days"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product information",
      "blocks": [
        {
          "type": "trust",
          "settings": {
            "icon": "truck",
            "title": "Delivery within India",
