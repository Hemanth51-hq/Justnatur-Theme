<section class="section section--ink">
  <div class="page-width page-width--narrow text-center">
    <p class="eyebrow" style="color:var(--color-highlight);justify-content:center;">{{ section.settings.eyebrow }}</p>
    <h2 class="display">{{ section.settings.heading }}</h2>
    <p class="lede mx-auto" style="color:rgba(244,247,243,0.78);">{{ section.settings.text }}</p>
    <div style="max-width:28rem;margin:1.5rem auto 0;">
      {% form 'customer', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="Email address" required>
        <button class="btn btn--primary" type="submit">{{ section.settings.button_label }}</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Stay close"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the root ritual"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Notes on internal hair nutrition, rituals, and clean formulas — once a week."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
