<section class="section section--surface">
  <div class="page-width">
    <div class="reviews-header reveal">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="display" style="font-size:clamp(1.6rem,4vw,2.6rem);">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="lede">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="video-rail" data-video-rail>
      {%- for block in section.blocks -%}
        <article class="video-card reveal" {{ block.shopify_attributes }}>
          <div class="video-card__media">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: autoplay: false, loop: false, controls: true, muted: false, image_size: '800x' }}
            {%- elsif block.settings.youtube_id != blank -%}
              <iframe
                src="https://www.youtube.com/embed/{{ block.settings.youtube_id }}?rel=0&modestbranding=1"
                title="{{ block.settings.title | escape }}"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            {%- elsif block.settings.mp4_url != blank -%}
              <video controls preload="none" playsinline poster="{% if block.settings.poster != blank %}{{ block.settings.poster | image_url: width: 800 }}{% endif %}">
                <source src="{{ block.settings.mp4_url }}" type="video/mp4">
              </video>
            {%- elsif block.settings.poster != blank -%}
              {{ block.settings.poster | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}
              <span class="video-card__play">{% render 'icon', icon: 'play' %}</span>
            {%- else -%}
              <div class="video-card__placeholder">
                {% render 'icon', icon: 'play', size: 28 %}
                <span>{{ block.settings.title }}</span>
              </div>
            {%- endif -%}
          </div>
          <div class="video-card__body">
            <h3>{{ block.settings.title }}</h3>
            {%- if block.settings.caption != blank -%}
              <p>{{ block.settings.caption }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video carousel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Watch & learn" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer stories, founder notes & how to use" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Swipe to watch real routines — not just claims." }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "How to use Kesha Mula" },
        { "type": "textarea", "id": "caption", "label": "Caption", "default": "1 scoop · warm water · nightly" },
        { "type": "video", "id": "video", "label": "Shopify hosted video" },
        { "type": "text", "id": "youtube_id", "label": "YouTube video ID", "info": "e.g. dQw4w9WgXcQ" },
        { "type": "text", "id": "mp4_url", "label": "MP4 URL" },
        { "type": "image_picker", "id": "poster", "label": "Poster image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video carousel",
      "blocks": [
        { "type": "video", "settings": { "title": "How to use", "caption": "Nightly scoop ritual in 20 seconds" } },
        { "type": "video", "settings": { "title": "Customer story", "caption": "Less fall after 4 weeks" } },
        { "type": "video", "settings": { "title": "Founder note", "caption": "Why we built root nutrition" } }
      ]
    }
  ]
}
{% endschema %}
