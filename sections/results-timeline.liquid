<section class="section section--soft">
  <div class="page-width">
    <div class="reveal" style="max-width:42rem;">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="display">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="lede">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="timeline">
      {%- for block in section.blocks -%}
        <article class="timeline-step reveal" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index0 | times: 0.08 }}s;">
          <div class="timeline-step__week">{{ block.settings.week }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Results timeline",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What to expect"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Visible shift in weeks. Density that builds over months."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Expect a noticeable reduction in shedding in 3–4 weeks. Full density improvements are usually seen by month 3–4 with consistent daily use."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Timeline step",
      "settings": [
        { "type": "text", "id": "week", "label": "Label", "default": "Week 1–2" },
        { "type": "text", "id": "title", "label": "Title", "default": "Ritual locks in" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Your body starts receiving clean botanical nutrition every night." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Results timeline",
      "blocks": [
        { "type": "step", "settings": { "week": "Week 1–2", "title": "Ritual locks in", "text": "One scoop nightly. Digestion and nutrient uptake begin supporting the follicle." } },
        { "type": "step", "settings": { "week": "Week 3–4", "title": "Less shedding", "text": "Most users notice less hair on the pillow, brush, and bathroom floor." } },
        { "type": "step", "settings": { "week": "Week 6–8", "title": "Stronger feel", "text": "Hair feels less brittle. Breakage reduces. Texture starts to improve." } },
        { "type": "step", "settings": { "week": "Month 3–4", "title": "Visible density", "text": "Parting and crown often look fuller as the growth cycle stabilizes." } }
      ]
    }
  ]
}
{% endschema %}
