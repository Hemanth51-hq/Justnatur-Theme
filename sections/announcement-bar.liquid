{%- if section.settings.enable -%}
  <div
    class="announcement"
    role="region"
    aria-label="Announcement"
    data-announcement
    data-rotate="{{ section.settings.rotate }}"
    data-interval="{{ section.settings.interval | times: 1000 }}"
  >
    <div class="announcement__inner page-width">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div
            class="announcement__item{% if forloop.first %} is-active{% endif %}"
            data-announcement-item
            {{ block.shopify_attributes }}
            {% unless forloop.first %}hidden{% endunless %}
          >
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="announcement__item is-active" data-announcement-item>
          <span>{{ section.settings.fallback_text }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Enable", "default": true },
    { "type": "checkbox", "id": "rotate", "label": "Rotate messages", "default": true },
    {
      "type": "range",
      "id": "interval",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Rotation interval",
      "default": 4
    },
    {
      "type": "text",
      "id": "fallback_text",
      "label": "Fallback text",
      "default": "Free express shipping · COD available · 100% Ayurvedic"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free Express Shipping On All Orders" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free Express Shipping On All Orders" } },
        { "type": "message", "settings": { "text": "COD Available Across India" } },
        { "type": "message", "settings": { "text": "Trusted by 10,000+ People" } },
        { "type": "message", "settings": { "text": "100% Clean & Ayurvedic Ingredients" } },
        { "type": "message", "settings": { "text": "Secure Payments · UPI · Cards · Netbanking" } }
      ]
    }
  ]
}
{% endschema %}
