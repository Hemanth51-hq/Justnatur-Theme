<section class="section">
  <div class="page-width">
    <div class="text-center reveal" style="max-width:40rem;margin-inline:auto;">
      <p class="eyebrow" style="justify-content:center;">{{ section.settings.eyebrow }}</p>
      <h2 class="display">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="lede mx-auto">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="faq-list" data-faq>
      {%- for block in section.blocks -%}
        <div class="faq-item{% if forloop.first and section.settings.open_first %} is-open{% endif %}" {{ block.shopify_attributes }}>
          <button type="button" class="faq-item__q" data-faq-toggle aria-expanded="{% if forloop.first and section.settings.open_first %}true{% else %}false{% endif %}">
            {{ block.settings.question }}
          </button>
          <div class="faq-item__a" data-faq-panel>
            {{ block.settings.answer }}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FAQs"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Got questions? We’ve got answers."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Everything people ask before starting Kesha Mula."
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first question",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long until I see results for my hair fall?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Expect a noticeable reduction in shedding in 3–4 weeks. Consistent daily use is key. Full density improvements are usually seen by month 3–4."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "How long until I see results for my hair fall?",
            "answer": "Expect a noticeable reduction in shedding in 3–4 weeks. Consistent daily use is key, as it takes time to nourish the follicle and stabilize the hair growth cycle. Full density improvements are usually seen by month 3–4."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Is this safe to take daily alongside my vitamins or medication?",
            "answer": "Yes — our formula uses 100% natural, food-grade ingredients like Amla, Flaxseed, and Cumin. As a food supplement, it is designed to complement your diet. Consult your doctor if you have specific medical conditions."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What does it taste like?",
            "answer": "The blend is naturally earthy and slightly spiced — chatpata, not bitter. It’s balanced by the sweetness of beetroot and the bulk of flaxseed, and mixes easily into warm water, milk, or smoothies."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How does this compare to a hair serum or topical oil?",
            "answer": "We target the root cause; topicals target the symptom. Serums and oils work outside the scalp for shine and manageability. Kesha Mula delivers nutrients internally to strengthen the hair root — the only way to stop fall and stimulate new growth."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What happens after I finish the 30-day pack?",
            "answer": "Hair growth needs sustained nourishment. Stopping abruptly may allow the nutritional gap to reappear. For best long-term density, transition to a Value Pack once you see month-2 results."
          }
        }
      ]
    }
  ]
}
{% endschema %}
