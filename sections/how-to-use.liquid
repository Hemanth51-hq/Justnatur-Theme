<section class="section section--surface">
  <div class="page-width howto-grid">
    <div class="reveal">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="display" style="font-size:clamp(1.9rem,3.8vw,3rem);">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="lede">{{ section.settings.text }}</p>
      {%- endif -%}

      <div class="howto-list">
        {%- for block in section.blocks -%}
          <article class="howto-item" {{ block.shopify_attributes }}>
            <div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if section.settings.note != blank -%}
        <p class="muted" style="margin-top:1.25rem;font-size:0.88rem;">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>

    <div class="media-frame reveal">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag: loading: 'lazy', widths: '600,900,1200', sizes: '(min-width: 860px) 40vw, 100vw', alt: section.settings.heading
        }}
      {%- else -%}
        <div style="width:100%;height:100%;display:grid;place-items:center;padding:2rem;text-align:center;">
          <div>
            <div style="font-family:var(--font-display);font-size:2rem;margin-bottom:0.4rem;">1 scoop</div>
            <p class="muted" style="margin:0;">Warm water or milk · Nightly · Chatpata, not bitter</p>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How to use",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How to use Kesha Mula"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A simple night habit. A more natural morning."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "No capsules. No bitter powder chaos. One scoop into warm water or milk — designed to taste chatpata and stay easy every day."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note",
      "default": "Consistency matters more than intensity. Give the cycle 4–8 weeks before judging density."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Take one scoop" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "One measured scoop of Kesha Mula before bed." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How to use",
      "blocks": [
        { "type": "step", "settings": { "title": "Take one scoop", "text": "One measured scoop of Kesha Mula — start nightly for the first week." } },
        { "type": "step", "settings": { "title": "Mix with warm water or milk", "text": "Stir into a full glass. The blend is earthy and slightly spiced — balanced by beetroot and flaxseed." } },
        { "type": "step", "settings": { "title": "Drink it down", "text": "No capsules to swallow. Easy for people who dislike bitter powders." } },
        { "type": "step", "settings": { "title": "Stay consistent", "text": "Keep the ritual for 30–90 days. Transition to a Value Pack once month-2 results show." } }
      ]
    }
  ]
}
{% endschema %}
