<section class="hero" style="min-height: {{ section.settings.min_height }}vh;">
  <div class="hero__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          widths: '800,1200,1600,2000,2400',
          sizes: '100vw',
          alt: section.settings.image.alt
          | default: shop.name
      }}
    {%- else -%}
      <div class="hero__fallback"></div>
    {%- endif -%}
  </div>
  <div class="hero__overlay"></div>
  <div class="page-width">
    <div class="hero__content">
      <p class="eyebrow" style="color:#9fd6b8;">{{ section.settings.eyebrow }}</p>
      <div class="hero__brand">{{ section.settings.brand_line | default: 'Just' }}<span>{{ section.settings.brand_accent | default: 'Natur' }}</span></div>
      <h1 class="display" style="font-size:clamp(1.6rem,3.4vw,2.5rem);max-width:18ch;">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="lede" style="color:rgba(247,248,244,0.82);">{{ section.settings.text }}</p>
      {%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="btn btn--ghost" style="border-color:rgba(255,255,255,0.35);color:#fff;" href="{{ section.settings.secondary_link }}">
            {{ section.settings.secondary_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 70,
      "max": 100,
      "step": 1,
      "unit": "vh",
      "label": "Minimum height",
      "default": 92
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "100% clean · clinically proven · from within"
    },
    {
      "type": "text",
      "id": "brand_line",
      "label": "Brand first half",
      "default": "Just"
    },
    {
      "type": "text",
      "id": "brand_accent",
      "label": "Brand accent half",
      "default": "Natur"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Hair fall doesn’t start on the scalp. It starts inside."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Kesha Mula rebuilds the root with clean botanical nutrition — so strength returns where growth begins."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button",
      "default": "Shop Kesha Mula"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button",
      "default": "See the science"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
