<section class="section section--soft">
  <div class="page-width">
    <div class="reviews-header reveal">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="display" style="font-size:clamp(1.6rem,4vw,2.5rem);">{{ section.settings.heading }}</h2>
      </div>
      {%- if settings.social_instagram != blank -%}
        <a class="btn btn--ghost" href="{{ settings.social_instagram }}" target="_blank" rel="noopener">
          {% render 'icon', icon: 'instagram', size: 18 %} {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="ig-grid">
      {%- for block in section.blocks -%}
        <a
          class="ig-card reveal"
          href="{{ block.settings.link | default: settings.social_instagram }}"
          target="_blank"
          rel="noopener"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.caption | default: 'JustNatur on Instagram' }}
          {%- else -%}
            <div class="ig-card__placeholder">{% render 'icon', icon: 'instagram', size: 28 %}</div>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Instagram",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Community" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Root rituals from real customers" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Follow JustNatur" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "caption", "label": "Alt text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
