<section class="section{% if section.settings.soft_bg %} section--soft{% endif %}">
  <div class="page-width{% if section.settings.narrow %} page-width--narrow text-center{% endif %}">
    <div class="reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="display">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="lede rte {% if section.settings.narrow %}mx-auto{% endif %}">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div style="margin-top:1.5rem;">
          <a class="btn btn--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "checkbox",
      "id": "soft_bg",
      "label": "Soft background",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "narrow",
      "label": "Narrow width",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We don’t coat your hair. We rebuild it — strand by strand."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Shampoos and oils care for the shaft. JustNatur feeds the root with clean, clinically minded botanicals.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
