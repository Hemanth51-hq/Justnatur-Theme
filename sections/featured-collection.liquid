<section class="section">
  <div class="page-width">
    <div class="reviews-header reveal">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="display" style="font-size:clamp(1.8rem,3.5vw,2.8rem);">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="lede">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--ghost" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="product-grid">
      {%- liquid
        assign collection = collections[section.settings.collection]
        assign product_count = 0
      -%}
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
          {%- assign product_count = product_count | plus: 1 -%}
        {%- endfor -%}
      {%- else -%}
        {%- for product in collections.all.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
          {%- assign product_count = product_count | plus: 1 -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if product_count == 0 -%}
        {%- for i in (1..3) -%}
          <div class="product-card reveal">
            <div class="product-card__media">{{ 'product-' | append: i | placeholder_svg_tag }}</div>
            <div class="product-card__body">
              <h3 class="product-card__title">Sample product {{ i }}</h3>
              <div class="product-card__meta"><span class="price__regular">₹699</span></div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop the ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clean nutrition for stronger roots"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Start with Kesha Mula, or build your inside-out routine."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 3
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
