<section class="section section--surface">
  <div class="page-width">
    <div class="reveal" style="max-width:42rem;">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="display">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="lede">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="compare-wrap reveal">
      <table class="compare-table">
        <thead>
          <tr>
            <th>{{ section.settings.col_feature }}</th>
            <th>{{ section.settings.col_other_1 }}</th>
            <th>{{ section.settings.col_other_2 }}</th>
            <th class="is-highlight">{{ section.settings.col_ours }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td><strong>{{ block.settings.feature }}</strong></td>
              <td>
                {%- if block.settings.other_1 == 'yes' -%}
                  <span class="compare-yes">Yes</span>
                {%- elsif block.settings.other_1 == 'partial' -%}
                  <span class="muted">Partial</span>
                {%- else -%}
                  <span class="compare-no">No</span>
                {%- endif -%}
              </td>
              <td>
                {%- if block.settings.other_2 == 'yes' -%}
                  <span class="compare-yes">Yes</span>
                {%- elsif block.settings.other_2 == 'partial' -%}
                  <span class="muted">Partial</span>
                {%- else -%}
                  <span class="compare-no">No</span>
                {%- endif -%}
              </td>
              <td class="is-highlight">
                {%- if block.settings.ours == 'yes' -%}
                  <span class="compare-yes">Yes</span>
                {%- elsif block.settings.ours == 'partial' -%}
                  Partial
                {%- else -%}
                  <span class="compare-no">No</span>
                {%- endif -%}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand comparison",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why JustNatur"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why should I trust this over what I already use?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Oils and serums target the symptom. Kesha Mula targets the root cause — with clean, clinically minded botanicals."
    },
    {
      "type": "text",
      "id": "col_feature",
      "label": "Feature column",
      "default": "What matters"
    },
    {
      "type": "text",
      "id": "col_other_1",
      "label": "Competitor 1",
      "default": "Oils & shampoos"
    },
    {
      "type": "text",
      "id": "col_other_2",
      "label": "Competitor 2",
      "default": "Typical hair gummies"
    },
    {
      "type": "text",
      "id": "col_ours",
      "label": "Our brand column",
      "default": "Kesha Mula"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Targets the real reason hair falls" },
        {
          "type": "select",
          "id": "other_1",
          "label": "Competitor 1",
          "options": [
            { "value": "yes", "label": "Yes" },
            { "value": "partial", "label": "Partial" },
            { "value": "no", "label": "No" }
          ],
          "default": "no"
        },
        {
          "type": "select",
          "id": "other_2",
          "label": "Competitor 2",
          "options": [
            { "value": "yes", "label": "Yes" },
            { "value": "partial", "label": "Partial" },
            { "value": "no", "label": "No" }
          ],
          "default": "partial"
        },
        {
          "type": "select",
          "id": "ours",
          "label": "JustNatur",
          "options": [
            { "value": "yes", "label": "Yes" },
            { "value": "partial", "label": "Partial" },
            { "value": "no", "label": "No" }
          ],
          "default": "yes"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand comparison",
      "blocks": [
        { "type": "row", "settings": { "feature": "Targets the real reason hair falls", "other_1": "no", "other_2": "partial", "ours": "yes" } },
        { "type": "row", "settings": { "feature": "Visible results in 4 weeks", "other_1": "no", "other_2": "partial", "ours": "yes" } },
        { "type": "row", "settings": { "feature": "Long-term strength & density", "other_1": "no", "other_2": "partial", "ours": "yes" } },
        { "type": "row", "settings": { "feature": "Clinically backed ingredients", "other_1": "no", "other_2": "partial", "ours": "yes" } },
        { "type": "row", "settings": { "feature": "Supports hormone & stress-related fall", "other_1": "no", "other_2": "no", "ours": "yes" } },
        { "type": "row", "settings": { "feature": "Works with your existing routine", "other_1": "yes", "other_2": "yes", "ours": "yes" } },
        { "type": "row", "settings": { "feature": "No artificial sugars or preservatives", "other_1": "partial", "other_2": "no", "ours": "yes" } },
        { "type": "row", "settings": { "feature": "100% vegan & pesticide-free", "other_1": "partial", "other_2": "partial", "ours": "yes" } }
      ]
    }
  ]
}
{% endschema %}
