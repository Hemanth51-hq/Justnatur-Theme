<section class="section">
  <div class="page-width story-split">
    <div class="media-frame reveal">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag: loading: 'lazy', widths: '600,900,1200', sizes: '(min-width: 860px) 42vw, 100vw', alt: section.settings.heading
        }}
      {%- else -%}
        <div style="width:100%;height:100%;display:grid;place-items:center;padding:2rem;text-align:center;background:linear-gradient(160deg,var(--color-accent-soft),var(--color-secondary));">
          <div>
            <div class="header__logo-text" style="font-size:2rem;">Just<span>Natur</span></div>
            <p class="muted" style="margin:0.5rem 0 0;">Born from real struggle. Built with intention.</p>
          </div>
        </div>
      {%- endif -%}
    </div>
    <div class="reveal stack-md">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="display" style="font-size:clamp(1.7rem,4vw,2.8rem);">{{ section.settings.heading }}</h2>
      <div class="lede rte">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <div>
          <a class="btn btn--primary btn--magnetic" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Founder story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our philosophy" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Born from real struggle, built with intention"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>JustNatur stands for honest nutrition, not quick fixes. We believe true transformation begins within — by restoring balance, nourishing the body, and supporting it with what it truly needs. Nothing more. Nothing artificial.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop Kesha Mula" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Founder story" }]
}
{% endschema %}
