<section class="section">
  <div class="page-width founder-letter">
    <div class="founder-letter__frame float-media reveal mask-reveal">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            widths: '700,1000,1400',
            sizes: '(min-width: 900px) 40vw, 100vw',
            alt: section.settings.founder_name
        }}
      {%- else -%}
        <div style="width:100%;height:100%;display:grid;place-items:end start;padding:1.5rem;background:linear-gradient(160deg,#8f281d,#2a1a12);color:#fff8f0;">
          <div>
            <div class="header__logo-text" style="color:#fff8f0;font-size:2rem;">Just<span style="color:var(--color-highlight)">Natur</span></div>
            <p style="opacity:0.8;margin:0.4rem 0 0;">Founder-led. Root-first.</p>
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="founder-letter__paper reveal">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="display">{{ section.settings.heading }}</h2>
      <p class="founder-letter__quote">{{ section.settings.letter }}</p>
      <div class="rte lede" style="margin-bottom:1.5rem;">{{ section.settings.text }}</div>
      <div class="founder-signature">
        {{ section.settings.signature }}
        <small>{{ section.settings.founder_name }}{% if section.settings.founder_role != blank %} · {{ section.settings.founder_role }}{% endif %}</small>
      </div>
      {%- if section.settings.button_label != blank -%}
        <div style="margin-top:1.5rem;">
          <a class="btn btn--primary btn--magnetic" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Founder letter",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Founder image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A note from the founder" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We didn’t build another oil. We built a root ritual."
    },
    {
      "type": "textarea",
      "id": "letter",
      "label": "Founder letter excerpt",
      "default": "If your brush keeps collecting more than it should, the answer is rarely another coating. Hair fall begins inside — in stress, nutrition gaps, and a cycle that needs gentle consistency. Kesha Mula is our promise to treat that truth with clean botanicals, not empty claims."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Supporting text",
      "default": "<p>JustNatur stands for honest nutrition, not quick fixes. Modern Ayurveda, measured for everyday life.</p>"
    },
    { "type": "text", "id": "signature", "label": "Signature text", "default": "With roots," },
    { "type": "text", "id": "founder_name", "label": "Founder name", "default": "Team JustNatur" },
    { "type": "text", "id": "founder_role", "label": "Founder role", "default": "Founders" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Start with Kesha Mula" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Founder letter" }]
}
{% endschema %}
