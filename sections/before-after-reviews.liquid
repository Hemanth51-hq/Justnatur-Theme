<section class="section">
  <div class="page-width">
    <div class="reviews-header reveal">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="display">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="lede">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      <div class="muted">{{ section.settings.subheading }}</div>
    </div>

    <div class="ba-grid">
      {%- for block in section.blocks -%}
        <article class="ba-card reveal" {{ block.shopify_attributes }}>
          <div class="ba-card__images">
            <div class="ba-shot">
              <span class="ba-shot__label">Before</span>
              {%- liquid
                assign before_alt = 'Before — ' | append: block.settings.author
                assign after_alt = block.settings.after_label | default: 'After' | append: ' — ' | append: block.settings.author
              -%}
              {%- if block.settings.before_image != blank -%}
                {{
                  block.settings.before_image
                  | image_url: width: 700
                  | image_tag: loading: 'lazy', widths: '320,480,700', sizes: '(min-width: 980px) 16vw, 45vw', alt: before_alt
                }}
              {%- else -%}
                <div class="ba-shot__placeholder">Before<br>{{ block.settings.timeline | default: 'Day 0' }}</div>
              {%- endif -%}
            </div>
            <div class="ba-shot ba-shot--after">
              <span class="ba-shot__label">{{ block.settings.after_label | default: 'After' }}</span>
              {%- if block.settings.after_image != blank -%}
                {{
                  block.settings.after_image
                  | image_url: width: 700
                  | image_tag: loading: 'lazy', widths: '320,480,700', sizes: '(min-width: 980px) 16vw, 45vw', alt: after_alt
                }}
              {%- else -%}
                <div class="ba-shot__placeholder">{{ block.settings.after_label | default: 'After' }}<br>{{ block.settings.timeline }}</div>
              {%- endif -%}
            </div>
          </div>

          <div class="ba-card__body">
            <div class="ba-card__meta">
              <span class="stars" aria-hidden="true">
                {% render 'icon', icon: 'star', size: 14 %}
                {% render 'icon', icon: 'star', size: 14 %}
                {% render 'icon', icon: 'star', size: 14 %}
                {% render 'icon', icon: 'star', size: 14 %}
                {% render 'icon', icon: 'star', size: 14 %}
              </span>
              <span>{{ block.settings.timeline }}</span>
            </div>
            <h3 class="ba-card__title">{{ block.settings.title }}</h3>
            <div class="ba-card__profile">
              {%- if block.settings.age != blank -%}<span class="ba-pill">{{ block.settings.age }}</span>{%- endif -%}
              {%- if block.settings.concern != blank -%}<span class="ba-pill">{{ block.settings.concern }}</span>{%- endif -%}
              {%- if block.settings.duration != blank -%}<span class="ba-pill">{{ block.settings.duration }}</span>{%- endif -%}
            </div>
            <p class="ba-card__quote">“{{ block.settings.quote }}”</p>
            {%- if block.settings.results != blank -%}
              <div class="ba-card__results">
                {%- assign results = block.settings.results | split: '|' -%}
                {%- for result in results -%}
                  <span class="chip">{{ result | strip }}</span>
                {%- endfor -%}
              </div>
            {%- endif -%}
            <div class="review__author">
              {{ block.settings.author }}
              {%- if block.settings.verified -%}
                <span class="badge" style="margin-left:0.45rem;">Verified</span>
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Before & after reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Proof over promises" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real roots. Real timelines."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Upload customer photos in the theme editor. Consistency is the product."
    },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Verified journeys" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Before/after review",
      "settings": [
        { "type": "image_picker", "id": "before_image", "label": "Before image" },
        { "type": "image_picker", "id": "after_image", "label": "After image" },
        { "type": "text", "id": "after_label", "label": "After label", "default": "After 8 Weeks" },
        { "type": "text", "id": "timeline", "label": "Timeline", "default": "8 weeks" },
        { "type": "text", "id": "title", "label": "Title", "default": "Less hair on the pillow" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "After consistent use, shedding felt more controlled." },
        { "type": "text", "id": "age", "label": "Age", "default": "Age 29" },
        { "type": "text", "id": "concern", "label": "Hair concern", "default": "Stress fall" },
        { "type": "text", "id": "duration", "label": "Duration used", "default": "Used 60 days" },
        { "type": "text", "id": "results", "label": "Result chips", "default": "Less shedding | Stronger feel" },
        { "type": "text", "id": "author", "label": "Author", "default": "Anusha R." },
        { "type": "checkbox", "id": "verified", "label": "Verified", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Before & after reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "after_label": "After 8 Weeks",
            "timeline": "8 weeks",
            "title": "Less hair while washing",
            "quote": "After using Kesha Mula consistently for 3–4 weeks, the hair fall reduced a lot.",
            "age": "Age 31",
            "concern": "Wash-day fall",
            "duration": "Used 8 weeks",
            "results": "Less fall | Reordered",
            "author": "Anusha R."
          }
        },
        {
          "type": "review",
          "settings": {
            "after_label": "After 8 Weeks",
            "timeline": "8 weeks",
            "title": "Postpartum shedding eased",
            "quote": "It felt gentle and natural. My hair fall reduced slowly without side effects.",
            "age": "Age 28",
            "concern": "Postpartum",
            "duration": "Used 60 days",
            "results": "Gentler fall | Better energy",
            "author": "Swathi M."
          }
        },
        {
          "type": "review",
          "settings": {
            "after_label": "After 12 Weeks",
            "timeline": "12 weeks",
            "title": "Front hair looks fuller",
            "quote": "After three months, my hair feels thicker and more manageable.",
            "age": "Age 36",
            "concern": "Thinning at front",
            "duration": "Used 90 days",
            "results": "Denser feel | Continuing",
            "author": "Kavitha S."
          }
        }
      ]
    }
  ]
}
{% endschema %}
