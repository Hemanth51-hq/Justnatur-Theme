<svg
  class="icon icon-{{ icon }}"
  aria-hidden="true"
  focusable="false"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  {%- case icon -%}
    {%- when 'cart' -%}
      <path d="M6 7h14l-1.4 8.2a2 2 0 0 1-2 1.8H9.2a2 2 0 0 1-2-1.7L5.2 3.8A1 1 0 0 0 4.2 3H2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="9.5" cy="20" r="1.2" fill="currentColor"/>
      <circle cx="17.5" cy="20" r="1.2" fill="currentColor"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.2" stroke="currentColor" stroke-width="1.7"/>
      <path d="M16 16l4.2 4.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    {%- when 'truck' -%}
      <path d="M3 7h11v9H3V7zm11 3h4l3 3v3h-7v-6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <circle cx="7.5" cy="18" r="1.4" fill="currentColor"/>
      <circle cx="17.5" cy="18" r="1.4" fill="currentColor"/>
    {%- when 'shield' -%}
      <path d="M12 3l8 3v6c0 5-3.4 7.8-8 9-4.6-1.2-8-4-8-9V6l8-3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'leaf' -%}
      <path d="M5 14c4-9 14-10 14-10s1 10-8 14c-2 .9-4 .5-5-1-1.2-1.6-1.4-2.7-1-3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M9 15c2-3 5-5 8-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'star' -%}
      <path d="M12 3.5l2.4 4.9 5.4.8-3.9 3.8.9 5.4L12 15.8 7.2 18.4l.9-5.4L4.2 9.2l5.4-.8L12 3.5z" fill="currentColor"/>
    {%- else -%}
      <circle cx="12" cy="12" r="7" stroke="currentColor" stroke-width="1.7"/>
  {%- endcase -%}
</svg>
