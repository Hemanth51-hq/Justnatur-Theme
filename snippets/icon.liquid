<svg
  class="icon icon-{{ icon }}"
  aria-hidden="true"
  focusable="false"
  width="{{ size | default: 22 }}"
  height="{{ size | default: 22 }}"
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  {%- case icon -%}
    {%- when 'cart' -%}
      <path d="M6 7h14l-1.4 8.2a2 2 0 0 1-2 1.8H9.2a2 2 0 0 1-2-1.7L5.2 3.8A1 1 0 0 0 4.2 3H2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="9.5" cy="20" r="1.15" fill="currentColor"/>
      <circle cx="17.5" cy="20" r="1.15" fill="currentColor"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.2" stroke="currentColor" stroke-width="1.6"/>
      <path d="M16.2 16.2L21 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    {%- when 'arrow' -%}
      <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'tick' -%}
      <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'warning' -%}
      <path d="M12 3l10 18H2L12 3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M12 10v4M12 17.5v.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    {%- when 'truck' -%}
      <path d="M3 7h11v9H3V7zm11 3h4l3 3v3h-7v-6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <circle cx="7.5" cy="18" r="1.3" fill="currentColor"/>
      <circle cx="17.5" cy="18" r="1.3" fill="currentColor"/>
    {%- when 'shield' -%}
      <path d="M12 3l8 3v6c0 5-3.4 7.8-8 9-4.6-1.2-8-4-8-9V6l8-3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'leaf' -%}
      <path d="M5 14c4-9 14-10 14-10s1 10-8 14c-2 .9-4 .5-5-1-1.2-1.6-1.4-2.7-1-3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M9 15c2-3 5-5 8-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'star' -%}
      <path d="M12 3.6l2.2 4.5 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5L4.8 8.8l5-.7L12 3.6z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
    {%- when 'hair' -%}
      <path d="M12 21c4.5-1 7-5 7-10 0-4-2.4-7-7-8-4.6 1-7 4-7 8 0 5 2.5 9 7 10z" stroke="currentColor" stroke-width="1.5"/>
      <path d="M9 10c.8 2 2 3.5 3 5 .9-1.5 2.1-3 3-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'root' -%}
      <path d="M12 3v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M12 11c-2 2-4 5-4 8M12 11c2 2 4 5 4 8M12 14c-1.2 1-2 2.4-2 4M12 14c1.2 1 2 2.4 2 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'bottle' -%}
      <path d="M9 3h6v3l2 2v13a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V8l2-2V3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M9 3h6M8 12h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'oil' -%}
      <path d="M12 3c3 4 5 7 5 10a5 5 0 1 1-10 0c0-3 2-6 5-10z" stroke="currentColor" stroke-width="1.5"/>
      <path d="M10.5 14.5c.5 1.2 1.5 2 2.8 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    {%- when 'doctor' -%}
      <circle cx="12" cy="7" r="3" stroke="currentColor" stroke-width="1.5"/>
      <path d="M5 20c1.4-3.2 3.8-5 7-5s5.6 1.8 7 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M12 10.5v4M10 12.5h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'science' -%}
      <path d="M9 3h6M10 3v5l-4.5 8.5A2.2 2.2 0 0 0 7.4 20h9.2a2.2 2.2 0 0 0 1.9-3.5L14 8V3" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M8.5 14h7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.5"/>
      <path d="M12 8v4.5l3 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'gift' -%}
      <rect x="4" y="9" width="16" height="11" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
      <path d="M4 13h16M12 9v11M12 9c-2.2 0-4-1.2-4-2.5S10.2 4 12 5.5C13.8 4 16 4.8 16 6.5S14.2 9 12 9z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    {%- when 'return' -%}
      <path d="M8 8H4v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M5 12a7 7 0 1 0 2-5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'whatsapp' -%}
      <path d="M12 3.5a8.2 8.2 0 0 0-7 12.5L4 21l5.2-1.4A8.2 8.2 0 1 0 12 3.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M9.2 9.3c.3-.5.6-.5.9-.5h.3c.2 0 .4 0 .5.4l.7 1.7c.1.2 0 .4-.1.5l-.4.5c-.1.1-.2.3 0 .5.3.5.9 1.2 1.7 1.7.4.3.6.2.8 0l.5-.5c.2-.2.4-.2.6-.1l1.6.7c.3.1.4.3.4.5v.4c0 .3 0 .6-.3.8-.4.4-1.1.7-2 .5-2.1-.4-4.4-2.2-5.6-4.3-.5-.8-.8-1.7-.8-2.4 0-.5.2-.8.5-1z" fill="currentColor"/>
    {%- when 'scalp' -%}
      <circle cx="12" cy="10" r="6.5" stroke="currentColor" stroke-width="1.5"/>
      <path d="M8 18c1.2-1.5 2.5-2.2 4-2.2S14.8 16.5 16 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="10" cy="9" r=".7" fill="currentColor"/>
      <circle cx="14" cy="9.5" r=".7" fill="currentColor"/>
      <circle cx="12" cy="12" r=".7" fill="currentColor"/>
    {%- when 'growth' -%}
      <path d="M5 19h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M7 16l3.2-5 2.3 3L17 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M14 7h3v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'cod' -%}
      <rect x="3" y="6" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/>
      <path d="M3 10h18M8 14h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'upi' -%}
      <path d="M6 17l5-11h2l5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M8.5 13h7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'card' -%}
      <rect x="3" y="6" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/>
      <path d="M3 10h18M7 14h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'play' -%}
      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.5"/>
      <path d="M10 8.8v6.4L16 12 10 8.8z" fill="currentColor"/>
    {%- when 'instagram' -%}
      <rect x="4" y="4" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="16.6" cy="7.4" r=".8" fill="currentColor"/>
    {%- when 'amazon' -%}
      <path d="M5 15c3.5 2.2 8.5 2.4 13 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M7 10.5c.8-2.5 2.5-4 5-4 2.8 0 4.5 1.7 4.5 4.2 0 2.4-1.5 4-3.8 4.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'blinkit' -%}
      <path d="M8 4h5l3 8H9L8 4zM9 12l-2 8h10l1.5-5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    {%- else -%}
      <circle cx="12" cy="12" r="7" stroke="currentColor" stroke-width="1.6"/>
  {%- endcase -%}
</svg>
