[
  {
    "name": "theme_info",
    "theme_name": "JustNatur",
    "theme_version": "2.0.0",
    "theme_author": "JustNatur",
    "theme_documentation_url": "https://www.justnatur.in",
    "theme_support_url": "https://www.justnatur.in"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 220,
        "step": 4,
        "unit": "px",
        "label": "Logo width",
        "default": 140
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "Brand tagline",
        "default": "Clean nutrition. Stronger roots."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#F4E2CE"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface",
        "default": "#FFF8F0"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Secondary text",
        "default": "#555555"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted",
        "default": "#777777"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Primary",
        "default": "#B53325"
      },
      {
        "type": "color",
        "id": "color_accent_soft",
        "label": "Primary soft",
        "default": "#F3D6C8"
      },
      {
        "type": "color",
        "id": "color_highlight",
        "label": "Accent gold",
        "default": "#E5A657"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary",
        "default": "#DFBC94"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border",
        "default": "#E6D0B5"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "range",
        "id": "type_scale",
        "min": 90,
        "max": 120,
        "step": 1,
        "unit": "%",
        "label": "Type scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "text",
        "id": "social_whatsapp",
        "label": "WhatsApp number",
        "info": "Include country code, e.g. 917075987708"
      }
    ]
  },
  {
    "name": "Cart & offers",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer_enabled",
        "label": "Enable cart drawer",
        "default": true
      },
      {
        "type": "text",
        "id": "cart_empty_message",
        "label": "Empty cart message",
        "default": "Your cart is waiting for cleaner nutrition."
      },
      {
        "type": "checkbox",
        "id": "enable_cart_progress",
        "label": "Enable cart progress rewards",
        "default": true
      },
      {
        "type": "number",
        "id": "progress_tier_1",
        "label": "Tier 1 threshold (₹)",
        "default": 499,
        "info": "Free shipping threshold in rupees"
      },
      {
        "type": "text",
        "id": "progress_tier_1_label",
        "label": "Tier 1 label",
        "default": "Free Shipping"
      },
      {
        "type": "number",
        "id": "progress_tier_2",
        "label": "Tier 2 threshold (₹)",
        "default": 999
      },
      {
        "type": "text",
        "id": "progress_tier_2_label",
        "label": "Tier 2 label",
        "default": "Free Hair Oil"
      },
      {
        "type": "number",
        "id": "progress_tier_3",
        "label": "Tier 3 threshold (₹)",
        "default": 1499
      },
      {
        "type": "text",
        "id": "progress_tier_3_label",
        "label": "Tier 3 label",
        "default": "Premium Gift"
      }
    ]
  },
  {
    "name": "Product defaults",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Show vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "enable_sticky_atc",
        "label": "Enable sticky add to cart",
        "default": true
      },
      {
        "type": "text",
        "id": "social_proof_rating",
        "label": "Global rating text",
        "default": "4.6/5 · Based on 50 reviews",
        "info": "Single source of truth used across buy box & strips"
      },
      {
        "type": "text",
        "id": "social_proof_buyers",
        "label": "Global buyers text",
        "default": "Trusted by 10,000+ people"
      }
    ]
  }
]
