{% layout none %}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
      :root {
        --color-bg: {{ settings.color_background }};
        --color-surface: {{ settings.color_surface }};
        --color-text: {{ settings.color_text }};
        --color-muted: {{ settings.color_text_muted }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-soft: {{ settings.color_accent_soft }};
        --color-highlight: {{ settings.color_highlight }};
        --color-border: {{ settings.color_border }};
        --font-display: 'Fraunces', Georgia, serif;
        --font-body: 'Plus Jakarta Sans', sans-serif;
        --type-scale: 1;
      }
      body {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem;
      }
      .password-form {
        display: flex;
        gap: 0.5rem;
        justify-content: center;
        margin-top: 1.5rem;
        flex-wrap: wrap;
      }
    </style>
  </head>
  <body>
    <div class="page-width page-width--narrow text-center">
      <div class="header__logo-text" style="font-size:2.4rem;margin-bottom:1rem;">Just<span>Natur</span></div>
      <h1 class="display" style="font-size:2rem;">Opening soon</h1>
      <p class="lede mx-auto">{{ settings.brand_tagline }}</p>
      {% form 'customer', class: 'password-form newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="prospect, password page">
        <input type="email" name="contact[email]" placeholder="Email address" required>
        <button class="btn btn--primary" type="submit">Notify me</button>
      {% endform %}
    </div>
  </body>
</html>
