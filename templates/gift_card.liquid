{% layout none %}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ gift_card.balance | money }} gift card — {{ shop.name }}</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body style="min-height:100vh;display:grid;place-items:center;padding:2rem;text-align:center;">
    <div>
      <h1 class="display" style="font-size:2rem;">{{ shop.name }} Gift Card</h1>
      <p class="lede">Balance: {{ gift_card.balance | money }}</p>
      <p><strong>{{ gift_card.code | format_code }}</strong></p>
    </div>
  </body>
</html>
